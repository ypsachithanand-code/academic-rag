# Core Application Settings
APP_NAME=Academic RAG
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Phase 2 — Document Storage Settings
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
SQLITE_DB_PATH=data/academic_rag.db
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=["application/pdf"]

# Phase 3 — Document Chunking & BGE-M3 Embedding Settings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIR=data/embeddings
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Phase 4 — Qdrant Vector Database & Search Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=academic_documents
QDRANT_TIMEOUT=5.0
QDRANT_UPSERT_BATCH_SIZE=64
TOP_K=5
MAX_TOP_K=20

# Phase 5 — Local LLM RAG Settings
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_DEVICE=auto
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.2

# Phase 6 — Hybrid Retrieval & Reranking Settings
HYBRID_RETRIEVAL_ENABLED=true
DENSE_TOP_K=10
LEXICAL_TOP_K=10
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=auto
RERANKER_TOP_N=20
FINAL_TOP_K=5
RRF_K=60.0

# Phase 7 — Research Assistant & Conversation Settings
MAX_CONVERSATION_MESSAGES=10
MAX_CONVERSATION_TOKENS=2048
DEFAULT_RESEARCH_MODE=qa



